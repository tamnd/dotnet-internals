<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    Lesson code is read before it is run, so it is written for a reader rather than for an
    analyser. A lesson declares a variable to give it a name, prints an intermediate value it
    could have inlined, and leaves the long form of a call in place because the long form is the
    part being taught. None of that is worth failing a build over, and a lesson that has to be
    contorted to satisfy a style rule stops being a lesson.

    The rules that stay on are the ones about correctness. Nullable is still enabled, and the
    analysers still run, they just do not fail the build.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisMode>Default</AnalysisMode>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    A file based app has the trimming and native AOT analysers on, because the point of one is
    that dotnet publish can turn it into a single native binary. A lesson is never published. It
    is run once by the build and once by a reader, and half of what it exists to show is done
    through reflection, which is exactly what those analysers warn about. Left on, every lesson
    that loads an assembly and asks it for a type prints five warnings before it prints anything a
    reader wanted, and warnings nobody can act on are how people learn to scroll past warnings.

    A lesson that is about trimming or about AOT turns them back on in its own directory, and Part
    IX is where that happens.
  -->
  <PropertyGroup>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
  </PropertyGroup>

</Project>
