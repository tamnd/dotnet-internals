{
  "name": "dotnet-internals E0",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit"
      ],
      "settings": {
        "dotnet.dotnetPath": "/home/vscode/.dotnet"
      }
    }
  },
  "containerEnv": {
    "DOTNET_ROOT": "/home/vscode/.dotnet",
    "DOTNET_NOLOGO": "1",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
  },
  "remoteEnv": {
    "PATH": "/home/vscode/.dotnet:/home/vscode/.dotnet/tools:${containerEnv:PATH}"
  },
  "postAttachCommand": "dotnet run --project tools/xray -- banner",
  "hostRequirements": {
    "cpus": 2
  }
}
